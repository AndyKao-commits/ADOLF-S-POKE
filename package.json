{
  "name": "home-ktv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "youtubei.js": "^14.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
